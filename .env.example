# Public Supabase browser configuration. Use a non-production project for development/tests.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Exact trusted origin. Production must be HTTPS and must not include a path or wildcard.
NEXT_PUBLIC_SITE_URL=https://meucesto.example.com

# Custom invite messages are sent by the app. `disabled` keeps generate/copy available.
EMAIL_PROVIDER=disabled
EMAIL_FROM=Meu Cesto <convites@meucesto.example.com>
EMAIL_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Required by Open Food Facts. Keep the monitored contact current.
OPENFOODFACTS_USER_AGENT=MeuCesto/1.0 (meucesto@webmails.org)

RECEIPT_SIGNED_URL_TTL_SECONDS=300
RECEIPT_MAX_BYTES=5242880
RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters
INVITE_VALIDATION_MAX_ATTEMPTS=10
PASSWORD_RESET_MAX_ATTEMPTS=5
AI_OCR_DAILY_LIMIT=10
AI_PROVIDER_TIMEOUT_MS=90000

# Optional receipt extraction. A provider is enabled only when its key and model are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Retention defaults. Receipt objects are quarantined immediately and purged after 30 days.
RECEIPT_DELETION_GRACE_DAYS=30
INVITE_RETENTION_DAYS=90
AUDIT_RETENTION_MONTHS=12
# Optional archive destination. Empty means expired audit events are deleted.
AUDIT_ARCHIVE_URL=
AUDIT_ARCHIVE_BEARER_TOKEN=
# Failed/incomplete receipt uploads are reconciled after this safety window.
RECEIPT_ORPHAN_GRACE_HOURS=24

# CI/release comparison target. Defaults to origin/main when omitted.
VERSION_BASE_REF=origin/main

# Hosted Supabase tooling. Keep access tokens out of committed files.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
