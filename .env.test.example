# Use an isolated Supabase project or the local Supabase stack. Never point tests at production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key
SUPABASE_SECRET_KEY=replace_with_local_secret_key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

EMAIL_PROVIDER=disabled
EMAIL_FROM=Meu Cesto <tests@meucesto.example.com>
OPENFOODFACTS_USER_AGENT=MeuCesto/1.0 (meucesto@webmails.org)
RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-test-only-characters

RECEIPT_SIGNED_URL_TTL_SECONDS=300
RECEIPT_MAX_BYTES=5242880
INVITE_VALIDATION_MAX_ATTEMPTS=10
PASSWORD_RESET_MAX_ATTEMPTS=5
AI_OCR_DAILY_LIMIT=10

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

RECEIPT_DELETION_GRACE_DAYS=30
INVITE_RETENTION_DAYS=90
AUDIT_RETENTION_MONTHS=12
AUDIT_ARCHIVE_URL=
AUDIT_ARCHIVE_BEARER_TOKEN=
RECEIPT_ORPHAN_GRACE_HOURS=24
